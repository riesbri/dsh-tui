Output ../.github/assets/dshline-demo.gif
Output ../.github/assets/dshline-demo.mp4
Set Width 1200
Set Height 700
Set FontSize 18
Set Padding 20
Set TypingSpeed 45ms
Set Shell zsh
Sleep 1s
Type "pnpm dsh --profile dshline"
Enter
Sleep 4s
Type "/model"
Sleep 3s
Enter
Sleep 2s
Type "opencode-go/deepseek-v4-flash"
Sleep 3.5s
Enter
Sleep 2.5s
Type "/plugins"
Sleep 2.5s
Enter
Sleep 5s
Escape
Sleep 2s
Type "Spawn a codex_subagent and prompt directly: "
Sleep 2.0s
Type "Investigate any possible performance optimizations"
Sleep 4.0s
Enter
Sleep 8.5s
Type "/timing"
Sleep 2.0s
Enter
Sleep 14.5s
Type "/work"
Sleep 3s
Enter
Sleep 4.0s
Escape
Sleep 1s
Type "/exit"
Sleep 2s
